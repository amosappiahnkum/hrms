        { "code": "ROPE_OFFSHORE", "name": "Rope access (offshore)", "kind": "earning", "calculation": "rate_per_unit", "rate": 5, "currency": "USD", "unit": "day", "taxable": true, "sort_order": 51, "_confirm": "CONFIRM: rate per day" },
        { "code": "ROPE_ONSHORE", "name": "Rope access (onshore)", "kind": "earning", "calculation": "rate_per_unit", "rate": 3, "currency": "USD", "unit": "day", "taxable": true, "sort_order": 52, "_confirm": "CONFIRM: rate per day" }
