# Production settings, read by docker-compose.prod.yml and every production make target.
# make env-prod copies this to .env.production (owner-only, never committed); fill in every empty value, then
# make check-prod. Development keeps using .env.

APP_NAME="HRMS"
APP_ENV=production
APP_DEBUG=false
# php artisan key:generate --show (in any container), pasted here
APP_KEY=
# After rotating APP_KEY: the old key(s), comma-separated, until `make artisan-prod cmd=app:reencrypt` has run cleanly.
APP_PREVIOUS_KEYS=
# Fingerprints of bank / mobile money numbers (duplicate checks). Back it up with APP_KEY.
# echo "base64:$(openssl rand -base64 32)"
PAYMENT_FINGERPRINT_KEY=
APP_URL=https://
FRONTEND_URL=https://
APP_SUPPORT_MAIL=
# Port the host nginx proxies to (bound to 127.0.0.1 only)
APP_PORT=8003

ORGANIZATION=
SYSTEM_USER_MAIL=

# Exactly the frontend's origin(s), comma-separated
CORS_ALLOWED_ORIGINS=https://
SANCTUM_STATEFUL_DOMAINS=
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_DRIVER=file
SESSION_LIFETIME=120

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=hrms
# The app's own user, with rights on its database only (not root)
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_DRIVER=reverb
BROADCAST_CONNECTION=reverb
FILESYSTEM_DRIVER=local

# The Redis container; Redis starts with this password: openssl rand -hex 32
REDIS_HOST=hrms_redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Laravel publishes events to the Reverb container; browsers connect through the host nginx
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=hrms_reverb
REVERB_PORT=6001
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=6001

GOTENBERG_URL=http://hrms_gotenberg:3000

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# MinIO / S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_COMMON_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=
HOLIDAY_BASE_URL=https://www.googleapis.com/calendar/v3/calendars/en.gh%23holiday%40group.v.calendar.google.com/events?key=YOUR_GOOGLE_API_KEY

SLACK_SUPPORT_WEBHOOK_URL=
